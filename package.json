{
  "name": "fastgpt-cli",
  "version": "0.3.0",
  "description": "命令行管理 FastGPT：工作流 DSL 构建、知识库文档与 QA 导入、权限配置、发布渠道、运行调试",
  "type": "module",
  "bin": {
    "fastgpt": "./bin/fastgpt.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "lib",
    "examples",
    "tests",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fastgpt",
    "cli",
    "workflow",
    "rag",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastgpt-apps/fastgpt-cli.git"
  },
  "homepage": "https://github.com/fastgpt-apps/fastgpt-cli#readme",
  "bugs": {
    "url": "https://github.com/fastgpt-apps/fastgpt-cli/issues"
  },
  "scripts": {
    "test": "node tests/smoke.mjs && node --test tests/import-tagged.test.mjs",
    "test:validate": "node bin/fastgpt.mjs wf validate examples/dsl-contract-review.json",
    "test:all": "npm test && npm run test:validate"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
